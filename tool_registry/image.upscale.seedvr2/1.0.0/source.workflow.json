tion","name":"resolution","type":"INT","widget":{"name":"resolution"},"link":null},{"localized_name":"max_resolution","name":"max_resolution","type":"INT","widget":{"name":"max_resolution"},"link":null},{"localized_name":"batch_size","name":"batch_size","type":"INT","widget":{"name":"batch_size"},"link":null},{"localized_name":"uniform_batch_size","name":"uniform_batch_size","type":"BOOLEAN","widget":{"name":"uniform_batch_size"},"link":null},{"localized_name":"color_correction","name":"color_correction","type":"COMBO","widget":{"name":"color_correction"},"link":null},{"localized_name":"temporal_overlap","name":"temporal_overlap","shape":7,"type":"INT","widget":{"name":"temporal_overlap"},"link":null},{"localized_name":"prepend_frames","name":"prepend_frames","shape":7,"type":"INT","widget":{"name":"prepend_frames"},"link":null},{"localized_name":"input_noise_scale","name":"input_noise_scale","shape":7,"type":"FLOAT","widget":{"name":"input_noise_scale"},"link":null},{"localized_name":"latent_noise_scale","name":"latent_noise_scale","shape":7,"type":"FLOAT","widget":{"name":"latent_noise_scale"},"link":null},{"localized_name":"offload_device","name":"offload_device","shape":7,"type":"COMBO","widget":{"name":"offload_device"},"link":null},{"localized_name":"enable_debug","name":"enable_debug","shape":7,"type":"BOOLEAN","widget":{"name":"enable_debug"},"link":null}],"outputs":[{"localized_name":"图像","name":"IMAGE","type":"IMAGE","links":[1]}],"title":"④ 高清放大 · 在此调节尺寸与效果","properties":{"cnr_id":"seedvr2_videoupscaler","ver":"2.5.24","Node name for S&R":"SeedVR2VideoUpscaler","aux_id":"ainvfx/ComfyUI-SeedVR2_VideoUpscaler"},"widgets_values":[42,"fixed",2048,3072,1,false,"lab",0,0,0,0,"cpu",false]},{"id":6,"type":"SaveImage","pos":[1480,260],"size":[440,340],"flags":{},"order":8,"mode":0,"inputs":[{"localized_name":"图片","name":"images","type":"IMAGE","link":6},{"localized_name":"文件名前缀","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":null}],"title":"⑥ 输出预览与保存 · PNG","properties":{"cnr_id":"comfy-core","ver":"0.31.0"},"widgets_values":["SeedVR2/高清放大"]},{"id":7,"type":"MarkdownNote","pos":[40,550],"size":[340,300],"flags":{},"order":2,"mode":0,"inputs":[],"outputs":[],"title":"使用说明","properties":{},"widgets_values":["### 图片高清放大\n1. 在输入节点上传图片。\n2. 在高清放大节点设置尺寸。\n3. 点击运行，右侧预览并自动保存 PNG。\n\n**默认：短边 2048、长边最多 3072，保持比例。**\n\n1024×1024 → 2048×2048。\n透明 PNG 会保留透明通道。\n\n输出目录：`output/SeedVR2/`。"],"color":"#243b4a","bgcolor":"#304b5d"},{"id":8,"type":"MarkdownNote","pos":[960,640],"size":[440,340],"flags":{},"order":3,"mode":0,"inputs":[],"outputs":[],"title":"尺寸与效果参数","properties":{},"widgets_values":["### 主要调整这里\n- **resolution**：目标短边像素，不是倍数。可试 1536 / 2048 / 2560。\n- **max_resolution**：最长边上限；超过时按比例缩小。默认 3072。\n- **seed**：默认固定 42，便于对比参数；更换会改变重建细节。\n- **color_correction**：lab 保持原图色彩；也可对比 wavelet。\n- **input_noise_scale / latent_noise_scale**：默认 0；需要变化时少量增加（如 0.02–0.05），会改变细节。\n- **batch_size**：单张图片保持 1；temporal_overlap / prepend_frames 保持 0。\n\n想输出 4096×4096：两个尺寸都设 4096；需根据显存实测。"],"color":"#243b4a","bgcolor":"#304b5d"},{"id":9,"type":"MarkdownNote","pos":[1480,640],"size":[440,300],"flags":{},"order":4,"mode":0,"inputs":[],"outputs":[],"title":"显存与画质","properties":{},"widgets_values":["### 16GB 显存起步配置\n已启用 CPU 卸载、16 层 BlockSwap、512 分块，关闭编译与模型常驻。\n\n- 若放大阶段显存不足：将 **blocks_to_swap** 从 16 增至 24 或 32，或降低输出尺寸。\n- 若 VAE 阶段显存不足：减小 **encode/decode_tile_size**（如 384），保持 overlap 小于 tile_size。\n- 显存充足时可减少交换层数，提高速度。\n\nSeedVR2 会重建细节，请对比人脸、文字与纹理是否符合预期。"],"color":"#243b4a","bgcolor":"#304b5d"},{"id":2,"type":"JoinImageWithAlpha","pos":[1480,100],"size":[440,90],"flags":{},"order":7,"mode":0,"inputs":[{"localized_name":"图像","name":"image","type":"IMAGE","link":1},{"localized_name":"阿尔法","name":"alpha","type":"MASK","link":2}],"outputs":[{"localized_name":"图像","name":"IMAGE","type":"IMAGE","links":[6,7]}],"title":"⑤ 恢复原图透明度 · 自动匹配尺寸","properties":{"cnr_id":"comfy-core","ver":"0.31.0","Node name for S&R":"JoinImageWithAlpha"},"widgets_values":[]},{"id":1,"type":"LoadImage","pos":[40,100],"size":[340,390],"flags":{},"order":5,"mode":0,"inputs":[{"localized_name":"图像","name":"image","type":"COMBO","widget":{"name":"image"},"link":null},{"localized_name":"选择文件上传","name":"upload","type":"IMAGEUPLOAD","widget":{"name":"upload"},"link":null}],"outputs":[{"localized_name":"图像","name":"IMAGE","type":"IMAGE","links":[3]},{"localized_name":"遮罩","name":"MASK","type":"MASK","links":[2]}],"title":"① 输入图片 · 点击上传更换","properties":{"cnr_id":"comfy-core","ver":"0.31.0","Node name for S&R":"LoadImage"},"widgets_values":["0542d5933dc5811f3788a85c5c9b5aec-removebg-preview (1).png","image"]},{"id":11,"type":"PreviewImage","pos":[2030.8685045735285,102.95464035593463],"size":[745.0686496121061,772.6172182309875],"flags":{},"order":9,"mode":0,"inputs":[{"localized_name":"图像","name":"images","type":"IMAGE","link":7}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":null}],"properties":{"cnr_id":"comfy-core","ver":"0.31.0","Node name for S&R":"PreviewImage"},"widgets_values":[]}],"links":[[1,5,0,2,0,"IMAGE"],[2,1,1,2,1,"MASK"],[3,1,0,5,0,"IMAGE"],[4,3,0,5,1,"SEEDVR2_DIT"],[5,4,0,5,2,"SEEDVR2_VAE"],[6,2,0,6,0,"IMAGE"],[7,2,0,11,0,"IMAGE"]],"groups":[{"id":1,"title":"输入图片","bounding":[10,40,390,950],"color":"#3f789e","flags":{}},{"id":2,"title":"模型与省显存设置","bounding":[420,40,500,790],"color":"#536d52","flags":{}},{"id":3,"title":"手动调整放大参数","bounding":[930,40,500,980],"color":"#8a6941","flags":{}},{"id":4,"title":"结果与说明","bounding":[1450,40,500,930],"color":"#675780","flags":{}}],"config":{},"extra":{"ds":{"scale":0.7150000000000004,"offset":[-1032.1461470059492,76.62707308071933]}},"version":0.4}